  "item": [
    {
      "name": "POST /pet - Add Pet Scenarios",
      "description": "Test scenarios covering pet creation, valid status variants, missing required fields, and malformed payloads.",
      "item": [
        {
          "name": "Successfully add a new valid pet",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const dynamicId = Date.now() + Math.floor(Math.random() * 9000 + 1000);",
                  "pm.collectionVariables.set('dynamicPetId', dynamicId.toString());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Pet name is BuddyPlaywright', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.name).to.eql('BuddyPlaywright');",
                  "});",
                  "",
                  "pm.test('Pet status is available', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('available');",
                  "});",
                  "",
                  "pm.test('Pet ID matches created dynamic ID', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id.toString()).to.eql(pm.collectionVariables.get('dynamicPetId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "api_key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{dynamicPetId}},\n  \"category\": {\n    \"id\": 1,\n    \"name\": \"Dogs\"\n  },\n  \"name\": \"BuddyPlaywright\",\n  \"photoUrls\": [\n    \"https://example.com/photo.jpg\"\n  ],\n  \"tags\": [\n    {\n      \"id\": 1,\n      \"name\": \"friendly\"\n    }\n  ],\n  \"status\": \"available\"\n}"
            },
            "url": {
