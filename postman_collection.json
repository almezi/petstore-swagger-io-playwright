    {
      "name": "GET /pet/findByStatus - Find Pets Scenarios",
      "description": "Test scenarios covering single status queries, multi-status query parameters, unsupported statuses, and edge cases.",
      "item": [
        {
          "name": "Successfully find available pets",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is a non-empty array of available pets', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    pm.expect(jsonData.length).to.be.greaterThan(0);",
                  "    jsonData.forEach(function (pet) {",
                  "        pm.expect(pet.status).to.eql('available');",
                  "    });",
                  "});"
